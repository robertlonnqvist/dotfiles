# ==============================================================================
# BASH READLINE CONFIGURATION (Vi Mode Compatible)
# ==============================================================================

# Core Autocomplete Engine
set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set completion-query-items 200
set menu-complete-display-prefix on
set colored-completion-prefix on
set colored-stats on
set visible-stats on
set mark-directories on
set mark-symlinked-directories on
set match-hidden-files on

# Mode Initialization
set editing-mode vi
set show-mode-in-prompt on
set vi-ins-mode-string "\1\e[5 q\2"
set vi-cmd-mode-string "\1\e[1 q\2"

# ==============================================================================
# VI MODE KEYMAP OVERRIDES
# ==============================================================================
$if mode=vi

  # ----------------------------------
  # 1. Vi Insert Mode Shortcuts
  # ----------------------------------
  set keymap vi-insert

  # History & Line Navigation
  "\C-r": reverse-search-history
  "\C-s": forward-search-history
  "\C-p": previous-history
  "\C-n": next-history
  "\C-a": beginning-of-line
  "\C-e": end-of-line

  # Text Editing Actions
  "\C-w": backward-kill-word
  "\C-k": kill-line
  "\C-u": backward-kill-line
  "\C-l": clear-screen
  "\C-?": backward-delete-char
  "\177": backward-delete-char

  # Edit current command line in the editor, then execute it
  "\C-v": edit-and-execute-command

  # Show the common prefix first, then cycle through ambiguous matches
  "\C-i": menu-complete
  "\e[Z": menu-complete-backward

  # ----------------------------------
  # 2. Vi Command Mode Shortcuts
  # ----------------------------------
  set keymap vi-command

  "\C-v": edit-and-execute-command
  "\C-i": menu-complete
  "\e[Z": menu-complete-backward

  # ----------------------------------
  # 3. Global Context Maps (Shared Sequences)
  # ----------------------------------
  # Readline automatically applies these fallback sequences across modes

  # Word Movements (Ctrl/Alt + Arrow Keys)
  "\e[1;5D": backward-word
  "\e[5D":   backward-word
  "\e\e[D":  backward-word
  "\e[1;5C": forward-word
  "\e[5C":   forward-word
  "\e\e[C":  forward-word

  # Page Up/Down (History Search Navigation)
  "\e[5~": history-search-backward
  "\e[6~": history-search-forward

$endif
